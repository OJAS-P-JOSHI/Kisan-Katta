{
  "name": "kisan-katta-backend",
  "version": "1.0.0",
  "description": "Kisan Katta backend API server",
  "main": "dist/server.js",
  "private": true,
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "backfill:application-numbers": "ts-node scripts/backfill-application-numbers.ts",
    "migrate:phase-5a3": "ts-node scripts/migrate-phase-5a3-business-flow.ts",
    "payment:reset": "ts-node scripts/payment-reset.ts",
    "generate:location-master": "ts-node scripts/generate-location-master.ts",
    "generate:crop-master": "ts-node scripts/generate-crop-master.ts"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.8.1",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "razorpay": "^2.9.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
