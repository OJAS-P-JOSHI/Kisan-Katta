{
  "expo": {
    "name": "Kissan Agrisathi",
    "slug": "kisan-katta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/logo-circle.png",
    "scheme": "kisankatta",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/branding/logo-circle.png"
    },
    "android": {
      "icon": "./assets/branding/logo-circle.png",
      "adaptiveIcon": {
        "backgroundColor": "#1A4D2E",
        "foregroundImage": "./assets/branding/logo-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kisankatta.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F7F2",
          "image": "./assets/branding/logo-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "बाजारपेठ जाहिरातीसाठी फोटो निवडण्याची परवानगी द्या.",
          "cameraPermission": "बाजारपेठ जाहिरातीसाठी कॅमेरा वापरण्याची परवानगी द्या."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f052b55b-f9b7-4c7d-9557-3514d9d87f1a"
      }
    }
  }
}
