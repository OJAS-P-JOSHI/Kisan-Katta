{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://kisan-katta.onrender.com",
        "EXPO_PUBLIC_REQUEST_TIMEOUT": "20000",
        "EXPO_PUBLIC_APP_ENV": "production"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://kisan-katta.onrender.com",
        "EXPO_PUBLIC_REQUEST_TIMEOUT": "20000",
        "EXPO_PUBLIC_APP_ENV": "production"
      }
    }
  }
}
